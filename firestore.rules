rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'name', 'defaultFee', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.defaultFee is number && data.defaultFee >= 0
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'patientId', 'patientName', 'date', 'fee', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.patientId is string && data.patientId.size() <= 128
        && data.patientName is string && data.patientName.size() <= 120
        && data.date is string && data.date.size() <= 10
        && data.fee is number && data.fee >= 0
        && (data.status == 'received' || data.status == 'pending');
    }

    match /patients/{patientId} {
      allow read: if true;
      allow create, update: if isValidId(patientId) && isValidPatient(request.resource.data);
      allow delete: if isValidId(patientId);
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId) && isValidSession(request.resource.data);
      allow delete: if isValidId(sessionId);
    }
  }
}
